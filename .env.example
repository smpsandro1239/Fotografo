# ===========================================
# FOTOGRAFO - Variáveis de Ambiente (Root)
# ===========================================
# Este ficheiro documenta TODAS as variáveis necessárias no projeto.
# Copie para .env e preencha, OU configure individualmente em cada pasta:
#   backend/.env    (obrigatório)
#   frontend/.env.local (obrigatório)
#   mobile/.env     (obrigatório)
#
# cp .env.example .env && edit .env

# ===========================================
# BACKEND (NestJS) - Configuração Obrigatória
# ===========================================
# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/fotografo?schema=public"

# JWT Auth
JWT_SECRET="your-super-secret-jwt-key-min-32-chars-change-in-production"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-min-32-chars-change-in-production"
JWT_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_IN="7d"

# App
PORT=3001
NODE_ENV=development
FRONTEND_URL="http://localhost:3000"

# Cloudflare R2 (S3-compatible Storage)
CLOUDFLARE_ACCOUNT_ID="your-cloudflare-account-id"
CLOUDFLARE_ACCESS_KEY_ID="your-r2-access-key-id"
CLOUDFLARE_SECRET_ACCESS_KEY="your-r2-secret-access-key"
CLOUDFLARE_R2_BUCKET_NAME="fotografo"
# Opcional: domínio personalizado para URLs públicas
# CLOUDFLARE_R2_CUSTOM_DOMAIN="cdn.seudominio.com"

# Stripe Payments
STRIPE_SECRET_KEY="sk_test_your-stripe-secret-key"
STRIPE_WEBHOOK_SECRET="whsec_your-webhook-secret"
STRIPE_PUBLISHABLE_KEY="pk_test_your-publishable-key"

# Email (Resend - recomendado)
RESEND_API_KEY="re_your-resend-api-key"
# Ou Nodemailer/SMTP:
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="seu-email@gmail.com"
# SMTP_PASS="sua-senha-app"
# EMAIL_FROM="Fotografo <noreply@seudominio.com>"

# ===========================================
# FRONTEND (Next.js) - Configuração Obrigatória
# ===========================================
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your-publishable-key"

# Opcional: Analytics/Monitoring
# NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"
# NEXT_PUBLIC_SENTRY_DSN="https://xxx@sentry.io/xxx"

# ===========================================
# MOBILE (Expo) - Configuração Obrigatória
# ===========================================
EXPO_PUBLIC_API_URL="http://localhost:3001"
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your-publishable-key"

# Opcional
# EXPO_PUSH_TOKEN="xxx"
# EXPO_PUBLIC_GA_ID="G-XXXXXXXXXX"