# Raiz do monorepo — template de variáveis de ambiente.
# Copie as secções relevantes para backend/.env, frontend/.env.local e mobile/.env.
# NUNCA commitar ficheiros .env reais (ver .gitignore).

## ── Backend (NestJS) ─────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/fotografo?schema=public"

# JWT — segredos DISTINTOS, 32+ caracteres, obrigatórios em produção
JWT_SECRET="change-me-para-segredo-aleatorio-32chars-min"
JWT_REFRESH_SECRET="change-me-para-outro-segredo-distinto-32chars"
JWT_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_IN="7d"

# Stripe (test keys) — STRIPE_WEBHOOK_SECRET via `stripe listen`
STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"
STRIPE_PUBLISHABLE_KEY="pk_test_xxx"

# Cloudflare R2 (S3-compatível) — NUNCA commitar valores reais
CLOUDFLARE_ACCOUNT_ID="xxx"
CLOUDFLARE_ACCESS_KEY_ID="xxx"
CLOUDFLARE_SECRET_ACCESS_KEY="xxx"
CLOUDFLARE_R2_BUCKET_NAME="galerias"

# CORS / rede
CORS_ORIGINS="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"
TRUST_PROXY="false"          # true quando atrás de nginx/Vercel/Cloudflare
NODE_ENV=development
PORT=3001

# Email (opcional — integração ainda não implementada no código)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="noreply@exemplo.com"
# SMTP_PASS="app-password"
# EMAIL_FROM="Fotografo <noreply@exemplo.com>"
# RESEND_API_KEY="re_xxx"

## ── Frontend (Next.js → frontend/.env.local) ────────────────────
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_xxx"
# NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"
# NEXT_PUBLIC_SENTRY_DSN="https://xxx@sentry.io/xxx"

## ── Mobile (Expo → mobile/.env) ──────────────────────────────────
EXPO_PUBLIC_API_URL="http://localhost:3001"
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_xxx"
