# Base de dados
DATABASE_URL="postgresql://postgres:password@localhost:5432/fotografo?schema=public"

# JWT — usar segredos DISTINTOS, 32+ caracteres, obrigatórios em produção
JWT_SECRET="change-me-para-segredo-aleatorio-32chars-min"
JWT_REFRESH_SECRET="change-me-para-outro-segredo-distinto-32chars"
JWT_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_IN="7d"

# Stripe (test keys)
STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"
STRIPE_PUBLISHABLE_KEY="pk_test_xxx"

# Cloudflare R2 (S3-compatível) — NUNCA commitar valores reais
CLOUDFLARE_ACCOUNT_ID="xxx"
CLOUDFLARE_ACCESS_KEY_ID="xxx"
CLOUDFLARE_SECRET_ACCESS_KEY="xxx"
CLOUDFLARE_R2_BUCKET_NAME="galerias"

# CORS / URLs públicas
CORS_ORIGINS="http://localhost:3000,http://localhost:8081"
FRONTEND_URL="http://localhost:3000"

# Servidor
NODE_ENV=development
PORT=3001
