# ===========================================
# BACKEND - Variáveis de Ambiente
# ===========================================
# Copie este ficheiro para .env e preencha com os seus valores

# -------------------------------------------
# DATABASE (PostgreSQL)
# -------------------------------------------
DATABASE_URL="postgresql://postgres:password@localhost:5432/fotografo?schema=public"

# -------------------------------------------
# JWT AUTH
# -------------------------------------------
JWT_SECRET="your-super-secret-jwt-key-min-32-chars"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-min-32-chars"
JWT_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_IN="7d"

# -------------------------------------------
# APP
# -------------------------------------------
PORT=3001
NODE_ENV=development
FRONTEND_URL="http://localhost:3000"

# -------------------------------------------
# CLOUDFLARE R2 (S3-compatible Storage)
# -------------------------------------------
# Obtenha em: Cloudflare Dashboard > R2 > Manage R2 API Tokens
CLOUDFLARE_ACCOUNT_ID="your-account-id"
CLOUDFLARE_ACCESS_KEY_ID="your-access-key-id"
CLOUDFLARE_SECRET_ACCESS_KEY="your-secret-access-key"
CLOUDFLARE_R2_BUCKET_NAME="fotografo"
# Opcional: domínio personalizado para URLs públicas
# CLOUDFLARE_R2_CUSTOM_DOMAIN="cdn.seudominio.com"

# -------------------------------------------
# STRIPE PAYMENTS
# -------------------------------------------
# Obtenha em: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_your-secret-key"
STRIPE_WEBHOOK_SECRET="whsec_your-webhook-secret"
STRIPE_PUBLISHABLE_KEY="pk_test_your-publishable-key"

# -------------------------------------------
# EMAIL (Resend - recomendado) ou Nodemailer
# -------------------------------------------
# Obtenha em: https://resend.com/api-keys
RESEND_API_KEY="re_your-resend-api-key"
# Ou para Nodemailer (SMTP):
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="seu-email@gmail.com"
# SMTP_PASS="sua-senha-app"
# EMAIL_FROM="Fotografo <noreply@seudominio.com>"

# -------------------------------------------
# CORS / SECURITY
# -------------------------------------------
# Lista de origens permitidas (separadas por vírgula)
# CORS_ORIGINS="http://localhost:3000,https://seudominio.com"