{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // rootDir src => dist/main.js (esperado por start:prod e Dockerfile)
    "rootDir": "./src",
    "outDir": "./dist",
    "deleteOutDir": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "test", "dist", "**/*spec.ts", "prisma.config.ts"]
}
